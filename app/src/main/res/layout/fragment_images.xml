<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/freeJobSearchRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/search_bar_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="8dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@android:drawable/ic_menu_search"
                app:tint="@color/search_icon_tint" />

            <EditText
                android:id="@+id/searchBar"
                style="@style/Widget.Rojgaarwaala.EditText.SearchField"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/free_job_search_hint"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:maxLines="1" />

            <ImageView
                android:id="@+id/clearSearchButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@string/clear_search"
                android:padding="6dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:visibility="gone"
                app:tint="@color/search_hint" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/freeJobCountLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/freeJobSortChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_theme_chip"
            android:drawableEnd="@drawable/ic_chevron_down_white"
            android:drawablePadding="2dp"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="8dp"
            android:paddingBottom="6dp"
            android:text="@string/free_job_newest"
            android:textColor="@color/accent"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_theme_chip_muted"
            android:orientation="horizontal"
            android:padding="3dp">

            <ImageButton
                android:id="@+id/freeJobViewList"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_free_job_view_selected"
                android:contentDescription="@string/free_job_view_list"
                android:padding="7dp"
                android:src="@drawable/ic_free_job_list"
                app:tint="@color/brand_color_yellow" />

            <ImageButton
                android:id="@+id/freeJobViewTile"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/free_job_view_tile"
                android:padding="7dp"
                android:src="@drawable/ic_free_job_tile"
                app:tint="@color/search_hint" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/searchResultsCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:textColor="@color/search_hint"
        android:textSize="12sp"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/imagesRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp"
            android:scrollbars="vertical" />

        <ProgressBar
            android:id="@+id/freeJobProgress"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:theme="@style/ThemeOverlay.App.ProgressBarWhite"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/freeJobLoadMoreProgress"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="16dp"
            android:theme="@style/ThemeOverlay.App.ProgressBarWhite"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/noResultsLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/free_job_empty"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
