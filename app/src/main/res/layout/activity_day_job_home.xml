<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <ImageButton
            android:id="@+id/dayJobBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_arrow_back_white" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="1 Day Job"
            android:textColor="@color/white"
            android:textSize="19sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Find Work / Hire Workers -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="16dp"
        android:background="@drawable/bg_day_job_toggle"
        android:orientation="horizontal"
        android:padding="4dp">

        <TextView
            android:id="@+id/dayJobModeWork"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Find Work"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dayJobModeHire"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Hire Workers"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/dayJobRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Worker side -->
                <LinearLayout
                    android:id="@+id/dayJobWorkerPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <FrameLayout
                        android:id="@+id/dayJobMap"
                        android:layout_width="match_parent"
                        android:layout_height="230dp"
                        android:background="@drawable/bg_day_job_card"
                        android:clipToOutline="true" />

                    <TextView
                        android:id="@+id/dayJobMapNote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/day_job_green"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- First time: what work can you do? -->
                    <LinearLayout
                        android:id="@+id/dayJobWorkerSetup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_day_job_card"
                        android:orientation="vertical"
                        android:padding="14dp"
                        android:visibility="gone">

                        <TextView
                            style="@style/ResumeStepTitle"
                            android:text="What work can you do?" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="We will alert you when a job like this comes up near you."
                            android:textColor="@color/search_hint"
                            android:textSize="13sp" />

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/dayJobWorkerTrades"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp" />

                        <TextView
                            android:id="@+id/dayJobWorkerSave"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_brand_button"
                            android:gravity="center"
                            android:text="Start getting jobs"
                            android:textColor="@color/on_brand"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Registered worker: availability and my work -->
                    <LinearLayout
                        android:id="@+id/dayJobWorkerStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_day_job_card"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <com.google.android.material.switchmaterial.SwitchMaterial
                                android:id="@+id/dayJobAvailable"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Available for work"
                                android:textColor="@color/white"
                                android:textStyle="bold"
                                app:thumbTint="@color/brand_color_yellow" />

                            <TextView
                                android:id="@+id/dayJobMyTrades"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/search_hint"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/dayJobEditTrades"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:text="Edit"
                            android:textColor="@color/brand_color_yellow"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/dayJobMyJobs"
                            style="@style/ResumeOutlineButton"
                            android:minHeight="38dp"
                            android:text="My Jobs" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/dayJobSetLocation"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_free_job_map_button"
                        android:gravity="center"
                        android:text="Set my location"
                        android:textColor="@color/brand_color_yellow"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <TextView
                        style="@style/ResumeStepTitle"
                        android:layout_marginTop="16dp"
                        android:text="Jobs near you" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/dayJobWorkerList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:nestedScrollingEnabled="false" />

                    <TextView
                        android:id="@+id/dayJobWorkerEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:padding="24dp"
                        android:text="No jobs near you right now. Keep Available on and we will alert you."
                        android:textColor="@color/search_hint"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Company side -->
                <LinearLayout
                    android:id="@+id/dayJobCompanyPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/dayJobCompanyIntro"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_day_job_card"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:visibility="gone">

                        <TextView
                            style="@style/ResumeStepTitle"
                            android:text="Need workers for a day?" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Register your company once. Then post a job and workers near your site get it on their phone."
                            android:textColor="@color/search_hint"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/dayJobRegisterCompany"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="14dp"
                            android:background="@drawable/bg_brand_button"
                            android:gravity="center"
                            android:text="Register company"
                            android:textColor="@color/on_brand"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/dayJobCompanyHome"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/dayJobCompanyName"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textColor="@color/white"
                                android:textSize="17sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/dayJobCompanyStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_day_job_pill"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="2dp"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/dayJobCompanyEdit"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:padding="8dp"
                                android:text="Edit"
                                android:textColor="@color/brand_color_yellow"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/dayJobCompanyNote"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textColor="@color/search_hint"
                            android:textSize="13sp"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/dayJobAddJob"
                            android:layout_width="match_parent"
                            android:layout_height="64dp"
                            android:layout_marginTop="14dp"
                            android:background="@drawable/bg_brand_button"
                            android:gravity="center"
                            android:text="+ Add Job"
                            android:textColor="@color/on_brand"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="16dp"
                            android:background="@drawable/bg_day_job_toggle"
                            android:orientation="horizontal"
                            android:padding="4dp">

                            <TextView
                                android:id="@+id/dayJobTabActive"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="Active"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/dayJobTabHistory"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="History"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/dayJobCompanyList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:nestedScrollingEnabled="false" />

                        <TextView
                            android:id="@+id/dayJobCompanyEmpty"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:padding="24dp"
                            android:textColor="@color/search_hint"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/dayJobLoading"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="120dp"
                    android:indeterminateTint="@color/brand_color_yellow"
                    android:visibility="gone" />
            </FrameLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
