<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <ImageButton
            android:id="@+id/dayJobBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_arrow_back_white" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="1 दिन का काम"
            android:textColor="@color/white"
            android:textSize="19sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Find Work / Hire Workers -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="16dp"
        android:background="@drawable/bg_day_job_toggle"
        android:orientation="horizontal"
        android:padding="4dp">

        <TextView
            android:id="@+id/dayJobModeWork"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🔍 काम ढूँढें"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dayJobModeHire"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="👷 मज़दूर चाहिए"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/dayJobRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Worker side -->
                <LinearLayout
                    android:id="@+id/dayJobWorkerPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <FrameLayout
                        android:id="@+id/dayJobMap"
                        android:layout_width="match_parent"
                        android:layout_height="230dp"
                        android:background="@drawable/bg_day_job_card"
                        android:clipToOutline="true" />

                    <TextView
                        android:id="@+id/dayJobMapNote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/day_job_green"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- First time: what work can you do? -->
                    <LinearLayout
                        android:id="@+id/dayJobWorkerSetup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_day_job_card"
                        android:orientation="vertical"
                        android:padding="14dp"
                        android:visibility="gone">

                        <TextView
                            style="@style/ResumeStepTitle"
                            android:text="आप कौन सा काम करते हैं?" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="पास में ऐसा काम आते ही हम आपको ख़बर देंगे।"
                            android:textColor="@color/search_hint"
                            android:textSize="13sp" />

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/dayJobWorkerTrades"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp" />

                        <TextView
                            android:id="@+id/dayJobWorkerSave"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_brand_button"
                            android:gravity="center"
                            android:text="काम की ख़बर पाना शुरू करें"
                            android:textColor="@color/on_brand"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Registered worker: availability and my work -->
                    <LinearLayout
                        android:id="@+id/dayJobWorkerStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_day_job_card"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <com.google.android.material.switchmaterial.SwitchMaterial
                                android:id="@+id/dayJobAvailable"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="काम के लिए तैयार"
                                android:textColor="@color/white"
                                android:textStyle="bold"
                                app:thumbTint="@color/brand_color_yellow" />

                            <TextView
                                android:id="@+id/dayJobMyTrades"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/search_hint"
                                android:textSize="12sp" />

                            <com.google.android.material.switchmaterial.SwitchMaterial
                                android:id="@+id/dayJobSpeak"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minHeight="36dp"
                                android:text="नया काम बोलकर सुनाएँ  "
                                android:textColor="@color/search_hint"
                                android:textSize="12sp"
                                app:thumbTint="@color/brand_color_yellow" />

                            <TextView
                                android:id="@+id/dayJobAlertHours"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:paddingVertical="4dp"
                                android:textColor="@color/brand_color_yellow"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/dayJobEditTrades"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:text="बदलें"
                            android:textColor="@color/brand_color_yellow"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/dayJobMyJobs"
                            style="@style/ResumeOutlineButton"
                            android:minHeight="38dp"
                            android:text="📋 मेरे काम" />

                        <TextView
                            android:id="@+id/dayJobMyTeam"
                            style="@style/ResumeOutlineButton"
                            android:layout_marginStart="8dp"
                            android:minHeight="38dp"
                            android:text="👥 मेरी टीम" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/dayJobHeldBack"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_day_job_card"
                        android:padding="12dp"
                        android:textColor="@color/new_tag_red"
                        android:textSize="13sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/dayJobSetLocation"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_free_job_map_button"
                        android:gravity="center"
                        android:text="मेरी जगह चुनें"
                        android:textColor="@color/brand_color_yellow"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <TextView
                        style="@style/ResumeStepTitle"
                        android:layout_marginTop="16dp"
                        android:text="आपके पास के काम" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/dayJobWorkerList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:nestedScrollingEnabled="false" />

                    <TextView
                        android:id="@+id/dayJobWorkerEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:padding="24dp"
                        android:text="अभी पास में कोई काम नहीं। 'काम के लिए तैयार' चालू रखें, काम आते ही ख़बर देंगे।"
                        android:textColor="@color/search_hint"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Company side -->
                <LinearLayout
                    android:id="@+id/dayJobCompanyPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/dayJobCompanyIntro"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_day_job_card"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:visibility="gone">

                        <TextView
                            style="@style/ResumeStepTitle"
                            android:text="एक दिन के लिए मज़दूर चाहिए?" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="एक बार कंपनी जोड़ें। फिर काम डालें, आपकी साइट के पास के मज़दूरों को फ़ोन पर ख़बर जाएगी।"
                            android:textColor="@color/search_hint"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/dayJobRegisterCompany"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="14dp"
                            android:background="@drawable/bg_brand_button"
                            android:gravity="center"
                            android:text="कंपनी जोड़ें"
                            android:textColor="@color/on_brand"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/dayJobCompanyHome"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/dayJobCompanyName"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textColor="@color/white"
                                android:textSize="17sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/dayJobCompanyStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_day_job_pill"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="2dp"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/dayJobCompanyEdit"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:padding="8dp"
                                android:text="बदलें"
                                android:textColor="@color/brand_color_yellow"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/dayJobCompanyNote"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textColor="@color/search_hint"
                            android:textSize="13sp"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/dayJobAddJob"
                            android:layout_width="match_parent"
                            android:layout_height="64dp"
                            android:layout_marginTop="14dp"
                            android:background="@drawable/bg_brand_button"
                            android:gravity="center"
                            android:text="+ काम डालें"
                            android:textColor="@color/on_brand"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="16dp"
                            android:background="@drawable/bg_day_job_toggle"
                            android:orientation="horizontal"
                            android:padding="4dp">

                            <TextView
                                android:id="@+id/dayJobTabActive"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="चालू"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/dayJobTabHistory"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="पुराने"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/dayJobCompanyList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:nestedScrollingEnabled="false" />

                        <TextView
                            android:id="@+id/dayJobCompanyEmpty"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:padding="24dp"
                            android:textColor="@color/search_hint"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/dayJobLoading"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="120dp"
                    android:indeterminateTint="@color/brand_color_yellow"
                    android:visibility="gone" />
            </FrameLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
