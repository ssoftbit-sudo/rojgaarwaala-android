<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp">

            <ImageButton
                android:id="@+id/helpDeskBackButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_action_circle_outline"
                    android:contentDescription="Back"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:padding="10dp"
                android:src="@drawable/ic_chevron_left"
                app:tint="@color/white" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:text="@string/help_desk"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/frequently_asked_questions"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/helpDeskLoading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="16dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/helpDeskEmptyText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/help_desk_empty"
                    android:textColor="@color/search_hint"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/helpDeskFaqList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="12dp"
                    android:text="@string/submit_query"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/enquiryNameInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/modern_edit_text_background"
                    android:hint="@string/your_name"
                    android:inputType="textPersonName"
                    android:padding="14dp"
                    android:textColor="@color/white"
                    android:textColorHint="@color/search_hint" />

                <EditText
                    android:id="@+id/enquiryEmailInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/modern_edit_text_background"
                    android:hint="@string/your_email"
                    android:inputType="textEmailAddress"
                    android:padding="14dp"
                    android:textColor="@color/white"
                    android:textColorHint="@color/search_hint" />

                <EditText
                    android:id="@+id/enquiryMobileInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/modern_edit_text_background"
                    android:hint="@string/your_mobile"
                    android:inputType="phone"
                    android:maxLength="10"
                    android:padding="14dp"
                    android:textColor="@color/white"
                    android:textColorHint="@color/search_hint" />

                <EditText
                    android:id="@+id/enquirySubjectInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/modern_edit_text_background"
                    android:hint="@string/subject"
                    android:inputType="textCapSentences"
                    android:padding="14dp"
                    android:textColor="@color/white"
                    android:textColorHint="@color/search_hint" />

                <EditText
                    android:id="@+id/enquiryMessageInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/modern_edit_text_background"
                    android:gravity="top"
                    android:hint="@string/your_message"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="4"
                    android:padding="14dp"
                    android:textColor="@color/white"
                    android:textColorHint="@color/search_hint" />

                <Button
                    android:id="@+id/enquirySubmitButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_theme_primary_button"
                    android:text="@string/submit_query"
                    android:textAllCaps="false"
                    android:textColor="@color/white" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</FrameLayout>
