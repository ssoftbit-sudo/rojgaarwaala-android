<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/customBottomNav"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="74dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@color/app_background"
    android:elevation="10dp"
    android:paddingStart="4dp"
    android:paddingTop="4dp"
    android:paddingEnd="4dp"
    android:paddingBottom="8dp">

    <!-- Home Tab -->
    <LinearLayout
        android:id="@+id/tabHome"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingVertical="4dp"
        android:clickable="true"
        android:focusable="true">

        <FrameLayout
            android:id="@+id/pillHome"
            android:layout_width="52dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_bottom_nav_selected">

            <ImageView
                android:id="@+id/iconHome"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_home_bottom"
                app:tint="@color/app_background" />
        </FrameLayout>

        <TextView
            android:id="@+id/textHome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Home"
            android:textColor="@color/tab_selected"
            android:textSize="9sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="4dp"
            android:layout_gravity="center_horizontal"
            android:includeFontPadding="false" />
    </LinearLayout>

    <!-- Add Job Tab -->
    <LinearLayout
        android:id="@+id/tabAddJob"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingVertical="4dp"
        android:clickable="true"
        android:focusable="true">

        <FrameLayout
            android:id="@+id/pillAddJob"
            android:layout_width="52dp"
            android:layout_height="32dp">

            <ImageView
                android:id="@+id/iconAddJob"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_add_job_bottom"
                app:tint="@color/tab_unselected" />
        </FrameLayout>

        <TextView
            android:id="@+id/textAddJob"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Job"
            android:textColor="@color/tab_unselected"
            android:textSize="9sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="4dp"
            android:layout_gravity="center_horizontal"
            android:includeFontPadding="false" />
    </LinearLayout>

    <!-- Categories Tab -->
    <LinearLayout
        android:id="@+id/tabCategories"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingVertical="4dp"
        android:clickable="true"
        android:focusable="true">

        <FrameLayout
            android:id="@+id/pillCategories"
            android:layout_width="52dp"
            android:layout_height="32dp">

            <ImageView
                android:id="@+id/iconCategories"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_categories_bottom"
                app:tint="@color/tab_unselected" />
        </FrameLayout>

        <TextView
            android:id="@+id/textCategories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Categories"
            android:textColor="@color/tab_unselected"
            android:textSize="9sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="4dp"
            android:layout_gravity="center_horizontal"
            android:includeFontPadding="false" />
    </LinearLayout>

    <!-- Images Tab -->
    <LinearLayout
        android:id="@+id/tabImages"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingVertical="4dp"
        android:clickable="true"
        android:focusable="true">

        <FrameLayout
            android:id="@+id/pillImages"
            android:layout_width="52dp"
            android:layout_height="32dp">

            <ImageView
                android:id="@+id/iconImages"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_image"
                app:tint="@color/tab_unselected" />
        </FrameLayout>

        <TextView
            android:id="@+id/textImages"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/free_job"
            android:textColor="@color/tab_unselected"
            android:textSize="9sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="4dp"
            android:layout_gravity="center_horizontal"
            android:includeFontPadding="false" />
    </LinearLayout>

    <!-- Stories Tab -->
    <LinearLayout
        android:id="@+id/tabStories"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingVertical="4dp"
        android:clickable="true"
        android:focusable="true">

        <FrameLayout
            android:id="@+id/pillStories"
            android:layout_width="52dp"
            android:layout_height="32dp">

            <ImageView
                android:id="@+id/iconStories"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_image"
                app:tint="@color/tab_unselected" />

            <View
                android:id="@+id/storiesNavBadge"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_nav_badge_dot"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/textStories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Stories"
            android:textColor="@color/tab_unselected"
            android:textSize="9sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="4dp"
            android:layout_gravity="center_horizontal"
            android:includeFontPadding="false" />
    </LinearLayout>

</LinearLayout> 