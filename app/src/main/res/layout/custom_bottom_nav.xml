<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/customBottomNav"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/card_bg"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:gravity="bottom"
    android:minHeight="66dp"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingTop="8dp"
    android:paddingEnd="4dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:id="@+id/tabProfile"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/pillProfile"
            android:layout_width="52dp"
            android:layout_height="30dp">

            <ImageView
                android:id="@+id/iconProfile"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_nav_profile"
                app:tint="@color/tab_unselected" />
        </FrameLayout>

        <TextView
            android:id="@+id/textProfile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:text="@string/profile"
            android:textColor="@color/tab_unselected"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tabCategories"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/pillCategories"
            android:layout_width="52dp"
            android:layout_height="30dp">

            <ImageView
                android:id="@+id/iconCategories"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_nav_categories"
                app:tint="@color/tab_unselected" />
        </FrameLayout>

        <TextView
            android:id="@+id/textCategories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:text="Categories"
            android:textColor="@color/tab_unselected"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Raised above the bar: the one tab everyone needs to find again. -->
    <LinearLayout
        android:id="@+id/tabHome"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:clickable="true"
        android:clipChildren="false"
        android:focusable="true"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/pillHome"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_marginTop="-24dp"
            android:background="@drawable/bg_bottom_nav_home_selected"
            android:elevation="6dp">

            <ImageView
                android:id="@+id/iconHome"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_nav_home"
                app:tint="@color/on_brand" />
        </FrameLayout>

        <TextView
            android:id="@+id/textHome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:text="Home"
            android:textColor="@color/brand_color_yellow"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tabImages"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/pillImages"
            android:layout_width="52dp"
            android:layout_height="30dp">

            <ImageView
                android:id="@+id/iconImages"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_nav_free_job"
                app:tint="@color/tab_unselected" />
        </FrameLayout>

        <TextView
            android:id="@+id/textImages"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:text="@string/free_job"
            android:textColor="@color/tab_unselected"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tabStories"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/pillStories"
            android:layout_width="52dp"
            android:layout_height="30dp">

            <ImageView
                android:id="@+id/iconStories"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_nav_stories"
                app:tint="@color/tab_unselected" />

            <View
                android:id="@+id/storiesNavBadge"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_nav_badge_dot"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/textStories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:text="Stories"
            android:textColor="@color/tab_unselected"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
