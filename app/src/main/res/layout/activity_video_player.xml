<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:orientation="vertical">

    <!-- Top Bar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/black"
        app:navigationIcon="@drawable/ic_back_arrow"
        app:title="Video Detail"
        app:titleTextColor="@color/white" />

    <!-- Video Player (fixed at top) -->
    <FrameLayout
        android:id="@+id/videoPlayerFrame"
        android:layout_width="match_parent"
        android:layout_height="520dp"
        android:elevation="4dp">

        <androidx.media3.ui.PlayerView
            android:id="@+id/custom_video_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible"
            app:resize_mode="fit"
            app:show_buffering="when_playing"
            app:show_subtitle_button="false"
            app:show_timeout="2000"
            app:show_vr_button="false"
            app:use_controller="true" />

        <!-- Thumbnail Overlay -->
        <ImageView
            android:id="@+id/videoThumbnailOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <!-- Confetti View - On top of video, only shows when user likes -->
        <com.srijeesolution.rojgaarwaala.utils.ConfettiView
            android:id="@+id/confetti_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:focusable="false" />

        <!-- Fullscreen Video Progress Controls - Hidden since ExoPlayer has built-in controls -->
        <LinearLayout
            android:id="@+id/fullscreenProgressControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/gradient_overlay"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp"
            android:visibility="gone">

            <!-- Fullscreen SeekBar -->
            <SeekBar
                android:id="@+id/fullscreenVideoSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="0"
                android:progressBackgroundTint="@color/gray_light_3"
                android:progressTint="@color/color_green"
                android:thumbTint="@color/color_green" />

            <!-- Fullscreen Time Display -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/fullscreenCurrentTimeText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:gravity="start"
                    android:text="0:00"
                    android:textColor="@color/white"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/fullscreenTotalTimeText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:gravity="end"
                    android:text="0:00"
                    android:textColor="@color/white"
                    android:textSize="12sp" />

            </LinearLayout>
        </LinearLayout>

        <!-- Fullscreen Action Controls (Right Side) - Always Visible -->
        <LinearLayout
            android:id="@+id/fullscreenActionControls"
            android:layout_width="84dp"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginTop="40dp"
            android:layout_marginEnd="8dp"
            android:gravity="end"
            android:orientation="vertical"
            android:visibility="visible">

            <LinearLayout
                android:id="@+id/fullscreenApplyButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_apply_label_outline"
                    android:gravity="center"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="APPLY"
                    android:textColor="@color/brand_color_yellow"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_apply_now_badge"
                    android:gravity="center"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="NOW!"
                    android:textAllCaps="true"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginTop="-3dp"
                    android:background="@drawable/bg_apply_now_pointer"
                    android:rotation="45" />

            </LinearLayout>

            <!-- Call Button -->
            <LinearLayout
                android:id="@+id/fullscreenCallButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:contentDescription="Call"
                    android:src="@android:drawable/ic_menu_call"
                    app:tint="@color/brand_color_yellow" />

            </LinearLayout>

            <!-- Like Button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/fullscreenLikeButton"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:contentDescription="Like"
                    android:src="@drawable/img_like"
                    android:tint="@color/white" />

                <TextView
                    android:id="@+id/fullscreenLikeCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="0"
                    android:textColor="@color/white"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- Dislike Button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/fullscreenDislikeButton"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:contentDescription="Dislike"
                    android:src="@drawable/img_dislike"
                    android:tint="@color/white" />

                <TextView
                    android:id="@+id/fullscreenDislikeCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="0"
                    android:textColor="@color/white"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- Share Button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/fullscreenShareButton"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:contentDescription="Share"
                    android:src="@drawable/ic_share"
                    android:tint="@color/white" />

            </LinearLayout>
        </LinearLayout>

        <!-- Play/Pause Button - Hidden since ExoPlayer has built-in controls -->
        <ImageView
            android:id="@+id/playPauseButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:src="@android:drawable/ic_media_play"
            android:tint="@color/white"
            android:visibility="gone" />

        <!-- Fullscreen Button -->

        <LinearLayout
            android:id="@+id/ll"
            android:layout_width="84dp"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:gravity="center"
            android:visibility="visible">

            <ImageView
                android:id="@+id/fullscreenButton"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:clickable="true"
                android:focusable="true"
                android:scaleType="centerInside"
                android:src="@drawable/ic_fullscreen"
                android:visibility="visible"
                app:tint="@color/white" />
        </LinearLayout>
    </FrameLayout>

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Spacer to push content below video player -->
            <View
                android:id="@+id/spacerView"
                android:layout_width="match_parent"
                android:layout_height="400dp" />

            <!-- Video Progress Controls - Hidden since ExoPlayer has built-in controls -->
            <LinearLayout
                android:id="@+id/videoProgressControls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/black"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:visibility="gone">

                <!-- SeekBar -->
                <SeekBar
                    android:id="@+id/videoSeekBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="0"
                    android:progressBackgroundTint="@color/gray_light_3"
                    android:progressTint="@color/color_green"
                    android:thumbTint="@color/color_green" />

                <!-- Time Display -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/currentTimeText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="monospace"
                        android:gravity="start"
                        android:text="0:00"
                        android:textColor="@color/white"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/totalTimeText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="monospace"
                        android:gravity="end"
                        android:text="0:00"
                        android:textColor="@color/white"
                        android:textSize="12sp" />

                </LinearLayout>
            </LinearLayout>

            <!-- Like/Dislike/Share/Views Row - Hidden -->
            <LinearLayout
                android:id="@+id/actionRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/likeButton"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="Like"
                    android:src="@drawable/img_like"
                    android:tint="@color/white" />

                <TextView
                    android:id="@+id/likeCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="18dp"
                    android:text="0"
                    android:textColor="@color/white"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/dislikeButton"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="0dp"
                    android:contentDescription="Dislike"
                    android:src="@drawable/img_dislike"
                    android:tint="@color/white" />

                <TextView
                    android:id="@+id/dislikeCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="18dp"
                    android:text="0"
                    android:textColor="@color/white"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/shareButton"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="0dp"
                    android:layout_marginEnd="18dp"
                    android:contentDescription="Share"
                    android:src="@drawable/ic_share"
                    android:tint="@color/white" />

                <TextView
                    android:id="@+id/viewsCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="0dp"
                    android:text="0 views"
                    android:textColor="@color/white"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Related Videos Title -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="16dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/uploadTimeLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="start|center_vertical"
                    android:text="Upload Time"
                    android:textColor="@color/gray_light_3"
                    android:textSize="14sp" />

                <!-- Views Count -->
                <TextView
                    android:id="@+id/fullscreenViewsCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end|center_vertical"
                    android:text="Upload Time"
                    android:textColor="@color/white"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/relatedVideosLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="10dp"
                android:text="Related Videos"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Related Videos RecyclerView (Horizontal) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/relatedVideosRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="30dp"
                android:orientation="horizontal" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ProgressBar for loading (overlay) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:clickable="false">

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
