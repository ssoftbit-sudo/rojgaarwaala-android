<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:orientation="vertical">

    <!-- Top Bar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/black"
        app:titleTextColor="@color/white"
        app:navigationIcon="@drawable/ic_back_arrow"
        app:title="Video Detail" />

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Video Player (fixed height) -->
            <FrameLayout
                android:id="@+id/videoPlayerFrame"
                android:layout_width="match_parent"
                android:layout_height="260dp">

                <androidx.media3.ui.PlayerView
                    android:id="@+id/custom_video_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="visible"
                    app:show_timeout="2000"
                    app:show_buffering="when_playing"
                    app:use_controller="true"
                    app:show_subtitle_button="false"
                    app:show_vr_button="false"
                    app:resize_mode="fit" />

                <!-- Thumbnail Overlay -->
                <ImageView
                    android:id="@+id/videoThumbnailOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <!-- Fullscreen Video Progress Controls - Hidden since ExoPlayer has built-in controls -->
                <LinearLayout
                    android:id="@+id/fullscreenProgressControls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_gravity="bottom"
                    android:background="@drawable/gradient_overlay"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:visibility="gone">

                    <!-- Fullscreen SeekBar -->
                    <SeekBar
                        android:id="@+id/fullscreenVideoSeekBar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:progressTint="@color/color_green"
                        android:thumbTint="@color/color_green"
                        android:progressBackgroundTint="@color/gray_light_3"
                        android:max="100"
                        android:progress="0" />

                    <!-- Fullscreen Time Display -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="4dp">

                        <TextView
                            android:id="@+id/fullscreenCurrentTimeText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="0:00"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:fontFamily="monospace"
                            android:gravity="start" />

                        <TextView
                            android:id="@+id/fullscreenTotalTimeText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="0:00"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:fontFamily="monospace"
                            android:gravity="end" />

                    </LinearLayout>
                </LinearLayout>

                <!-- Fullscreen Action Controls (Right Side) -->
                <LinearLayout
                    android:id="@+id/fullscreenActionControls"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="20dp"
                    android:visibility="gone">

                    <!-- Like Button -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_marginBottom="16dp">

                        <ImageView
                            android:id="@+id/fullscreenLikeButton"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/img_like"
                            android:tint="@color/white"
                            android:contentDescription="Like" />

                        <TextView
                            android:id="@+id/fullscreenLikeCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:gravity="center"
                            android:layout_marginTop="4dp" />

                    </LinearLayout>

                    <!-- Dislike Button -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_marginBottom="16dp">

                        <ImageView
                            android:id="@+id/fullscreenDislikeButton"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/img_dislike"
                            android:tint="@color/white"
                            android:contentDescription="Dislike" />

                        <TextView
                            android:id="@+id/fullscreenDislikeCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:gravity="center"
                            android:layout_marginTop="4dp" />

                    </LinearLayout>

                    <!-- Share Button -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_marginBottom="16dp">

                        <ImageView
                            android:id="@+id/fullscreenShareButton"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_share"
                            android:tint="@color/white"
                            android:contentDescription="Share" />

                    </LinearLayout>

                    <!-- Views Count -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/fullscreenViewsCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 views"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:gravity="center" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Play/Pause Button - Hidden since ExoPlayer has built-in controls -->
                <ImageView
                    android:id="@+id/playPauseButton"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@android:drawable/ic_media_play"
                    android:layout_gravity="center"
                    android:visibility="gone"
                    android:tint="@color/white" />

                <!-- Fullscreen Button -->
                <ImageView
                    android:id="@+id/fullscreenButton"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/img_full_screen"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="16dp"
                    android:tint="@color/white"
                    android:visibility="visible"
                    android:clickable="true"
                    android:focusable="true" />
            </FrameLayout>

            <!-- Video Progress Controls - Hidden since ExoPlayer has built-in controls -->
            <LinearLayout
                android:id="@+id/videoProgressControls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/black"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:visibility="gone">

                <!-- SeekBar -->
                <SeekBar
                    android:id="@+id/videoSeekBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:progressTint="@color/color_green"
                    android:thumbTint="@color/color_green"
                    android:progressBackgroundTint="@color/gray_light_3"
                    android:max="100"
                    android:progress="0" />

                <!-- Time Display -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/currentTimeText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="0:00"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:fontFamily="monospace"
                        android:gravity="start" />

                    <TextView
                        android:id="@+id/totalTimeText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="0:00"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:fontFamily="monospace"
                        android:gravity="end" />

                </LinearLayout>
            </LinearLayout>

            <!-- Like/Dislike/Share/Views Row -->
            <LinearLayout
                android:id="@+id/actionRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:layout_marginTop="10dp">

                <ImageView
                    android:id="@+id/likeButton"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/img_like"
                    android:tint="@color/white"
                    android:contentDescription="Like" />
                <TextView
                    android:id="@+id/likeCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="18dp" />

                <ImageView
                    android:id="@+id/dislikeButton"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/img_dislike"
                    android:tint="@color/white"
                    android:contentDescription="Dislike"
                    android:layout_marginStart="0dp" />
                <TextView
                    android:id="@+id/dislikeCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="18dp" />

                <ImageView
                    android:id="@+id/shareButton"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_share"
                    android:tint="@color/white"
                    android:contentDescription="Share"
                    android:layout_marginStart="0dp"
                    android:layout_marginEnd="18dp" />

                <TextView
                    android:id="@+id/viewsCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 views"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:layout_marginStart="0dp" />
            </LinearLayout>

            <!-- Related Videos Title -->
            <TextView
                android:id="@+id/relatedVideosLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Related Videos"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp" />

            <!-- Related Videos RecyclerView (Horizontal) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/relatedVideosRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal" />
        </LinearLayout>
    </ScrollView>

    <!-- ProgressBar for loading (overlay) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:clickable="false">
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
