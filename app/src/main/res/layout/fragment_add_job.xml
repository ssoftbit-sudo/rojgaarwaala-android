<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/black">

    <!-- 👇 Your existing layout content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/black">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:visibility="gone"
                android:theme="@style/ThemeOverlay.App.ProgressBarWhite"/>

            <ScrollView
                android:id="@+id/scrollView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:layout_marginHorizontal="24dp"
                android:layout_marginBottom="20dp">

                <!-- Existing form inside LinearLayout -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center|top"
                    android:layout_marginBottom="20dp">

                    <!-- Header Section -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_marginTop="24dp"
                        android:layout_marginBottom="32dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Add New Job"
                            android:textColor="@color/white"
                            android:textStyle="bold"
                            android:textSize="28sp"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Share job opportunities with the community"
                            android:textColor="@color/gray_light_3"
                            android:textSize="16sp"
                            android:gravity="center" />

                    </LinearLayout>

                    <!-- Job Title Section -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Job Title"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp" />

                        <EditText
                            android:id="@+id/jobTitle"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:background="@drawable/modern_edit_text_background"
                            android:hint="Enter job title"
                            android:inputType="textPersonName"
                            android:textColorHint="@color/gray_light_3"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:paddingStart="20dp"
                            android:paddingEnd="20dp" />

                    </LinearLayout>

                    <!-- Job Description Section -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Job Description"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp" />

                        <EditText
                            android:id="@+id/jobDescription"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:background="@drawable/modern_edit_text_background"
                            android:hint="Enter job description"
                            android:inputType="textCapSentences"
                            android:textColorHint="@color/gray_light_3"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:paddingStart="20dp"
                            android:paddingEnd="20dp" />

                    </LinearLayout>

                    <!-- Job Category Section -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Job Category"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp" />

                        <EditText
                            android:id="@+id/jobCategory"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:background="@drawable/modern_edit_text_background"
                            android:hint="Enter job category"
                            android:inputType="textPersonName"
                            android:textColorHint="@color/gray_light_3"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:paddingStart="20dp"
                            android:paddingEnd="20dp" />

                    </LinearLayout>

                    <!-- Job Responsibility Section -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="32dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Job Responsibility"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp" />

                        <EditText
                            android:id="@+id/jobResponsibility"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:background="@drawable/modern_edit_text_background"
                            android:hint="Enter job responsibility"
                            android:inputType="textCapSentences"
                            android:textColorHint="@color/gray_light_3"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:paddingStart="20dp"
                            android:paddingEnd="20dp" />

                    </LinearLayout>

                    <!-- Submit Button -->
                    <Button
                        android:id="@+id/submitBtn"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="Submit Job"
                        android:textAllCaps="true"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:background="@drawable/modern_button_background"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="16dp" />

                </LinearLayout>

            </ScrollView>

        </FrameLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout> 