<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/resumeBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            android:src="@drawable/ic_arrow_back_white"
            app:tint="@color/white" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="रिज्यूमे बनाएँ"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/resumeStepLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/brand_color_yellow"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/resumeProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:max="4"
        android:progressTint="@color/brand_color_yellow" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Step 1: about you -->
        <ScrollView
            android:id="@+id/resumeStep1"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView style="@style/ResumeStepTitle" android:text="आपकी जानकारी" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/resumePhoto"
                        android:layout_width="88dp"
                        android:layout_height="104dp"
                        android:background="@drawable/modern_edit_text_background"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/resumePhotoButton"
                            style="@style/ResumeOutlineButton"
                            android:text="फोटो लगाएँ" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="ज़रूरी • साफ़ चेहरे वाली फोटो"
                            android:textColor="@color/search_hint"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView style="@style/ResumeLabel" android:text="पूरा नाम *" />
                <EditText android:id="@+id/resumeName" style="@style/ResumeField" android:inputType="textPersonName|textCapWords" />

                <TextView style="@style/ResumeLabel" android:text="अभी का फोन नंबर *" />
                <EditText android:id="@+id/resumeMobile" style="@style/ResumeField" android:inputType="phone" android:maxLength="10" />

                <TextView style="@style/ResumeLabel" android:text="ईमेल (ज़रूरी नहीं)" />
                <EditText android:id="@+id/resumeEmail" style="@style/ResumeField" android:inputType="textEmailAddress" />

                <TextView style="@style/ResumeLabel" android:text="जन्म तिथि *" />
                <TextView
                    android:id="@+id/resumeDob"
                    style="@style/ResumeField"
                    android:clickable="true"
                    android:focusable="true"
                    android:hint="तारीख चुनें" />

                <TextView style="@style/ResumeLabel" android:text="अभी किस ज़िले में रहते हैं *" />
                <EditText android:id="@+id/resumeDistrict" style="@style/ResumeField" android:inputType="textCapWords" />

                <TextView style="@style/ResumeLabel" android:text="अभी का पता (गाँव / मोहल्ला / शहर)" />
                <EditText android:id="@+id/resumeAddress" style="@style/ResumeField" android:inputType="textPostalAddress|textCapSentences" />
            </LinearLayout>
        </ScrollView>

        <!-- Step 2: wanted work, where, and experience -->
        <ScrollView
            android:id="@+id/resumeStep2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView style="@style/ResumeStepTitle" android:text="कौन सा काम चाहिए *" />
                <TextView style="@style/ResumeLabel" android:layout_marginTop="2dp" android:text="एक से ज़्यादा काम जोड़ सकते हैं" />
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/resumeRoles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />

                <TextView style="@style/ResumeStepTitle" android:layout_marginTop="24dp" android:text="कहाँ नौकरी चाहिए *" />
                <TextView style="@style/ResumeLabel" android:layout_marginTop="2dp" android:text="एक से ज़्यादा जगह चुन सकते हैं" />
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/resumeJobLocations"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />

                <TextView style="@style/ResumeStepTitle" android:layout_marginTop="24dp" android:text="काम का अनुभव" />

                <CheckBox
                    android:id="@+id/resumeFresher"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:buttonTint="@color/brand_color_yellow"
                    android:text="मुझे अभी काम का अनुभव नहीं है (फ्रेशर)"
                    android:textColor="@color/white"
                    android:textSize="15sp" />

                <LinearLayout
                    android:id="@+id/resumeExperienceList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/resumeAddExperience"
                    style="@style/ResumeOutlineButton"
                    android:layout_width="match_parent"
                    android:layout_marginTop="8dp"
                    android:text="+ अनुभव जोड़ें" />
            </LinearLayout>
        </ScrollView>

        <!-- Step 3: education and skills -->
        <ScrollView
            android:id="@+id/resumeStep3"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView style="@style/ResumeStepTitle" android:text="पढ़ाई" />

                <LinearLayout
                    android:id="@+id/resumeEducationList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/resumeAddEducation"
                    style="@style/ResumeOutlineButton"
                    android:layout_width="match_parent"
                    android:layout_marginTop="8dp"
                    android:text="+ पढ़ाई जोड़ें" />

                <TextView style="@style/ResumeStepTitle" android:layout_marginTop="28dp" android:text="हुनर" />
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/resumeSkills"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />

                <TextView style="@style/ResumeStepTitle" android:layout_marginTop="24dp" android:text="भाषाएँ" />
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/resumeLanguages"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />

                <TextView style="@style/ResumeStepTitle" android:layout_marginTop="24dp" android:text="ड्राइविंग लाइसेंस" />
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/resumeLicences"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </ScrollView>

        <!-- Step 4: preview -->
        <LinearLayout
            android:id="@+id/resumeStep4"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:visibility="gone">

            <TextView style="@style/ResumeLabel" android:layout_marginTop="0dp" android:text="रिज्यूमे की भाषा" />
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/resumeLanguageChoice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/resumePreviewPages"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="12dp" />
            </ScrollView>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/resumeWorking"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/brand_color_yellow"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <TextView
            android:id="@+id/resumePrevious"
            style="@style/ResumeOutlineButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="पीछे" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/resumeNext"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="2"
            android:background="@drawable/bg_brand_button"
            android:stateListAnimator="@null"
            android:text="आगे"
            android:textAllCaps="false"
            android:textColor="@color/on_brand"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
