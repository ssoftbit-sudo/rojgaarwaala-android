<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/customBottomNav"
    android:layout_width="match_parent"
    android:layout_height="66dp"
    android:orientation="horizontal"
    android:background="@color/black"
    android:paddingBottom="10dp">

    <!-- Home Tab -->
    <LinearLayout
        android:id="@+id/tabHome"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/iconHome"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_home_bottom"
            android:tint="@color/tab_selected"
            android:layout_gravity="center_horizontal" />

        <TextView
            android:id="@+id/textHome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HOME"
            android:textAllCaps="true"
            android:textColor="@color/tab_selected"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="6dp"
            android:layout_gravity="center_horizontal"
            android:includeFontPadding="false" />
    </LinearLayout>

    <!-- Add Job Tab -->
    <LinearLayout
        android:id="@+id/tabAddJob"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/iconAddJob"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_add_job_bottom"
            android:tint="@color/tab_unselected"
            android:layout_gravity="center_horizontal" />

        <TextView
            android:id="@+id/textAddJob"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ADD JOB"
            android:textAllCaps="true"
            android:textColor="@color/tab_unselected"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="6dp"
            android:layout_gravity="center_horizontal"
            android:includeFontPadding="false" />
    </LinearLayout>

    <!-- Categories Tab -->
    <LinearLayout
        android:id="@+id/tabCategories"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/iconCategories"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_categories_bottom"
            android:tint="@color/tab_unselected"
            android:layout_gravity="center_horizontal" />

        <TextView
            android:id="@+id/textCategories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CATEGORIES"
            android:textAllCaps="true"
            android:textColor="@color/tab_unselected"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="6dp"
            android:layout_gravity="center_horizontal"
            android:includeFontPadding="false" />
    </LinearLayout>

    <!-- Images Tab -->
    <LinearLayout
        android:id="@+id/tabImages"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/iconImages"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_image"
            android:tint="@color/tab_unselected"
            android:layout_gravity="center_horizontal" />

        <TextView
            android:id="@+id/textImages"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="IMAGES"
            android:textAllCaps="true"
            android:textColor="@color/tab_unselected"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="6dp"
            android:layout_gravity="center_horizontal"
            android:includeFontPadding="false" />
    </LinearLayout>

    <!-- Stories Tab -->
    <LinearLayout
        android:id="@+id/tabStories"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/iconStories"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_image"
            android:tint="@color/tab_unselected"
            android:layout_gravity="center_horizontal" />

        <TextView
            android:id="@+id/textStories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STORIES"
            android:textAllCaps="true"
            android:textColor="@color/tab_unselected"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="6dp"
            android:layout_gravity="center_horizontal"
            android:includeFontPadding="false" />
    </LinearLayout>

</LinearLayout> 