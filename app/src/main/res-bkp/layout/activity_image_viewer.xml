<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/black">

    <!-- Toolbar -->

    <!-- Full Screen Image Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Full Screen Image -->
        <com.srijeesolution.rojgaarwaala.presentation.ui.activity.ZoomableImageView
            android:id="@+id/fullScreenImageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/black" />

        <!-- Left Navigation Arrow -->
        <ImageButton
            android:id="@+id/leftArrowButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="16dp"
            android:background="@drawable/arrow_button_background"
            android:src="@drawable/ic_chevron_left"
            android:contentDescription="Previous image"
            android:visibility="gone"
            android:tint="@color/white"
            android:padding="12dp"
            android:layout_marginBottom="100dp"/>

        <!-- Right Navigation Arrow -->
        <ImageButton
            android:id="@+id/rightArrowButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="16dp"
            android:background="@drawable/arrow_button_background"
            android:src="@drawable/ic_chevron_right"
            android:contentDescription="Next image"
            android:visibility="gone"
            android:tint="@color/white"
            android:padding="12dp"
            android:layout_marginBottom="100dp"/>

        <!-- Image Info Container -->
        <LinearLayout
            android:id="@+id/imageInfoContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:background="@drawable/gradient_overlay"
            android:padding="16dp"
            android:visibility="gone">

            <!-- Title -->
            <TextView
                android:id="@+id/imageTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Image Title"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="8dp" />

            <!-- Description -->
            <TextView
                android:id="@+id/imageDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Image Description"
                android:textColor="@color/gray_light_3"
                android:textSize="14sp"
                android:maxLines="3"
                android:ellipsize="end" />

        </LinearLayout>

        <!-- Share Button -->
    </FrameLayout>

</LinearLayout> 