<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Keep optional so Play does not filter tablets / Wi‑Fi-only / no-SIM devices -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.wifi"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.screen.portrait"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.faketouch"
        android:required="false" />

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Photo/resume uploads use system pickers only. Explicitly strip any
         broad media permissions merged from dependencies (Play policy). -->
    <uses-permission
        android:name="android.permission.READ_MEDIA_IMAGES"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_VIDEO"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        tools:node="remove" />
    <!-- Foreground-only location, used to geo-verify employee attendance punches. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- Declared explicitly for Firebase Analytics (Play AD_ID policy / targetSdk 33+) -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />
    
    <application
        android:name=".utils.RojgaarwalaApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Rojgaarwaala"
        tools:targetApi="31"
        android:usesCleartextTraffic="true">

        <service
            android:name=".utils.FirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@mipmap/ic_launcher" />

        <!-- Injected from MAPS_API_KEY in local.properties so the key stays out of git. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${mapsApiKey}" />

        <activity
            android:name=".presentation.ui.activity.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Rojgaarwaala.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".presentation.ui.activity.LocationPickerActivity"
            android:exported="false"
            android:theme="@style/AppTheme.NoSplash" />
        <activity
            android:name=".presentation.ui.activity.MainActivity"
            android:exported="true"
            android:theme="@style/AppTheme.NoSplash"
            android:windowSoftInputMode="adjustPan|stateHidden"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="rojgaarwaala" />
            </intent-filter>
        </activity>
        <activity
            android:name=".presentation.ui.activity.ProductDetailsActivity"
            android:theme="@style/AppTheme.NoSplash"
            android:windowSoftInputMode="adjustPan|stateHidden"/>
        <activity
            android:name=".presentation.ui.activity.LoginActivity"
            android:theme="@style/AppTheme.NoSplash"
            android:windowSoftInputMode="adjustPan|stateHidden"/>
        <activity
            android:name=".presentation.ui.activity.RegisterActivity"
            android:theme="@style/AppTheme.NoSplash"
            android:windowSoftInputMode="adjustPan|stateHidden"/>
        <activity
            android:name=".presentation.ui.activity.ProfileActivity"
            android:theme="@style/AppTheme.NoSplash"
            android:windowSoftInputMode="adjustPan|stateHidden"/>
        <activity
            android:name=".presentation.ui.activity.HelpDeskActivity"
            android:theme="@style/AppTheme.NoSplash"
            android:windowSoftInputMode="adjustPan|stateHidden"/>

        <activity
            android:name=".presentation.ui.activity.VideoPlayerActivity"
            android:theme="@style/AppTheme.NoSplash"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:windowSoftInputMode="adjustPan|stateHidden" />
        <activity
            android:name=".presentation.ui.activity.OtpActivity"
            android:theme="@style/AppTheme.NoSplash"
            android:windowSoftInputMode="adjustPan|stateHidden"/>
        <activity android:name=".presentation.ui.activity.CategoryVideosActivity"
            android:launchMode="singleTask"/>
        <activity
            android:name=".presentation.ui.activity.ImageViewerActivity"
            android:theme="@style/AppTheme.NoSplash"
            android:windowSoftInputMode="adjustPan|stateHidden"/>
        <activity
            android:name=".presentation.ui.activity.ImagesListActivity"
            android:theme="@style/AppTheme.NoSplash"
            android:windowSoftInputMode="adjustPan|stateHidden"/>
        <activity
            android:name=".presentation.ui.activity.StoriesListActivity"
            android:theme="@style/AppTheme.NoSplash"
            android:windowSoftInputMode="adjustPan|stateHidden"/>
        <activity
            android:name=".presentation.ui.activity.StoryViewerActivity"
            android:theme="@style/AppTheme.NoSplash"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustPan|stateHidden"/>
        <activity
            android:name=".presentation.ui.activity.ApplyFormActivity"
            android:theme="@style/AppTheme.NoSplash"
            android:windowSoftInputMode="adjustPan|stateHidden"/>
        <activity
            android:name=".presentation.ui.activity.PaymentActivity"
            android:theme="@style/AppTheme.NoSplash"
            android:windowSoftInputMode="adjustPan|stateHidden"/>
        <activity
            android:name=".presentation.ui.activity.ApplicationStatusActivity"
            android:theme="@style/AppTheme.NoSplash"
            android:windowSoftInputMode="adjustPan|stateHidden"/>
        <activity
            android:name=".presentation.ui.activity.AppliedJobsActivity"
            android:theme="@style/AppTheme.NoSplash"
            android:windowSoftInputMode="adjustPan|stateHidden"/>
        <activity
            android:name=".presentation.ui.activity.AttendanceDashboardActivity"
            android:theme="@style/AppTheme.NoSplash"
            android:windowSoftInputMode="adjustPan|stateHidden"/>
        <activity
            android:name=".presentation.ui.activity.AttendanceHistoryActivity"
            android:theme="@style/AppTheme.NoSplash"
            android:windowSoftInputMode="adjustPan|stateHidden"/>
        <activity
            android:name=".presentation.ui.activity.MonthlyWageActivity"
            android:theme="@style/AppTheme.NoSplash"
            android:windowSoftInputMode="adjustPan|stateHidden"/>
        <activity
            android:name=".presentation.ui.activity.PaymentHistoryActivity"
            android:theme="@style/AppTheme.NoSplash"
            android:windowSoftInputMode="adjustPan|stateHidden"/>
        <activity
            android:name=".presentation.ui.activity.FactoryTermsActivity"
            android:theme="@style/AppTheme.NoSplash"
            android:windowSoftInputMode="adjustPan|stateHidden"/>

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="rojgaarwaala_channel" />

        <!-- FileProvider for sharing images -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>

    </application>

</manifest>